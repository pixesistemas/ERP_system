# ======================================================
# Plantilla de entorno para PRODUCCIÓN (Docker + Portainer)
# Copiala a un archivo .env en el servidor y completá los valores.
# NO subir este archivo con secretos a Git.
# ======================================================

# Servidor
PORT=3000
TZ=America/Argentina/Buenos_Aires

# Seguridad (NO usar la de desarrollo)
JWT_SECRET=genera-una-clave-larga-y-unica-con-32-letras-como-minimo
JWT_EXPIRES_IN=8h

# Superadmin (panel de administración de empresas).
# Definí una clave fuerte. Si no la ponés, en producción se genera una
# aleatoria y se muestra UNA VEZ en los logs del contenedor.
SUPERADMIN_PASSWORD=cambia-esta-clave-de-superadmin
SUPERADMIN_EMAIL=tu-correo@tudominio.com

# Envío de correo (recuperación de contraseña). Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=tucuenta@gmail.com  SMTP_PASS=clave-de-aplicacion
# Si no lo configurás, la recuperación no envía mail (queda registrada en logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PixeSistemas <no-reply@tudominio.com>"
# Correo de respaldo para recuperar el superadmin (si no tiene email cargado).
MAIL_RECOVERY_EMAIL=tu-correo@tudominio.com
# Minutos de validez del enlace de recuperación.
RESET_EXPIRA_MIN=60

# Base de datos SQLite (ruta DENTRO del contenedor; punto de montaje erp_data)
DB_PATH=/app/data/afip_api.db

# URL pública de la app (para QR, PDF y webhooks). Sin barra final.
# Ej: https://erp.midominio.com.ar
PUBLIC_BASE_URL=http://localhost:3000

# MercadoPago (pasarela de pagos / QR dinámico)
# Para "modo demo" (QR simulado) dejá vacíos estos dos.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_POS_ID=
# URL a la que MP notifica el pago. Publica el webhook del backend.
MERCADOPAGO_WEBHOOK_URL=http://localhost:3000/api/v1/pagos/webhook/mercadopago

# AFIP / ARCA (firma de comprobantes electrónicos)
AFIP_PRODUCTION=true

# OpenSSL (firma de pedidos AFIP). En Linux/Mac alcanza "openssl".
OPENSSL=openssl

# Certificado de AFIP (si el backend no lo lee desde el path por defecto):
# montá la carpeta con los certificados como volumen/secreto y pasá la
# variable CERT con el contenido o la ruta si el servicio lo soporta.
# CERT=

# IA conversacional (opcional). Si no la usás, queda el parser local.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Configuración del proyecto (no tocar salvo que sepas)
DEMO_MODE=false
