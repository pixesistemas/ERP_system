{
  "name": "ERP - Recordatorios de cobranzas (cuenta corriente)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 10 * * *" }] } },
      "id": "cron-cobranzas",
      "name": "Cron 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_BASE_URL }}/api/v1/n8n/cobranzas/enviar",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{ $env.ERP_API_KEY }}" }] },
        "options": {}
      },
      "id": "erp-cobranzas",
      "name": "Enviar cobranzas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    }
  ],
  "connections": {
    "Cron 10:00": { "main": [[{ "node": "Enviar cobranzas", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
