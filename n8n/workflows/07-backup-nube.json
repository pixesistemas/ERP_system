{
  "name": "ERP - Backup automatico y subida a la nube",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 3 * * *" }] } },
      "id": "cron-backup",
      "name": "Cron 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ERP_BASE_URL }}/api/v1/backup",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-backup-key", "value": "={{ $env.ERP_BACKUP_KEY }}" }] },
        "options": {}
      },
      "id": "erp-backup",
      "name": "Crear backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.ERP_BASE_URL }}/api/v1/backup/descargar",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-backup-key", "value": "={{ $env.ERP_BACKUP_KEY }}" }] },
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "erp-descarga",
      "name": "Descargar backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ 'backup-erp-' + $now.format('yyyy-MM-dd-HHmm') + '.sqlite' }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "list", "value": "root", "cachedResultName": "/" },
        "options": {}
      },
      "id": "drive-subir",
      "name": "Subir a Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [780, 0],
      "notes": "Elegí la cuenta de Google y, si querés, una carpeta propia (por ejemplo /Backups ERP) en las opciones del nodo."
    }
  ],
  "connections": {
    "Cron 03:00": { "main": [[{ "node": "Crear backup", "type": "main", "index": 0 }]] },
    "Crear backup": { "main": [[{ "node": "Descargar backup", "type": "main", "index": 0 }]] },
    "Descargar backup": { "main": [[{ "node": "Subir a Google Drive", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
