PORT=3000
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_EXPIRES_IN=8h
DB_PATH=./data/afip_api.db
DEMO_MODE=true
AFIP_PRODUCTION=false

# Ruta al ejecutable de OpenSSL (usado para firmar el pedido de acceso a
# AFIP/ARCA). En Linux/Mac normalmente alcanza con "openssl" a secas si
# está instalado y en el PATH del sistema. En Windows, poné la ruta
# completa, por ejemplo la que trae Git: C:\Program Files\Git\usr\bin\openssl.exe
OPENSSL=openssl

# IA conversacional opcional. Sin estas variables se usa el parser local.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Automatizaciones con n8n (opcional). El backup descarga TODA la base,
# por eso usa una clave propia y no la API Key de una empresa.
BACKUP_API_KEY=
N8N_ALERT_WEBHOOK_URL=
N8N_ESCALAMIENTO_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
ERROR_ALERTA_COOLDOWN_SEG=600
SUPERADMIN_WHATSAPP_TOKEN=
SUPERADMIN_WHATSAPP_PHONE_ID=
SUPERADMIN_WHATSAPP_TO=
